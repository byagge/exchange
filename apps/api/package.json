{
  "name": "@exchange/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --watch -r ./dist/load-env.cjs dist/main.js",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/load-env.cjs','dist/load-env.cjs')\"",
    "start": "node -r ./dist/load-env.cjs dist/main.js",
    "start:dev": "npm run build && npm run start",
    "watch": "tsc -p tsconfig.json -w --preserveWatchOutput"
  },
  "dependencies": {
    "@exchange/db": "file:../../packages/db",
    "@exchange/shared": "file:../../packages/shared",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/throttler": "^6.4.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.1",
    "ioredis": "^5.6.0",
    "multer": "^2.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tronweb": "^6.5.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
