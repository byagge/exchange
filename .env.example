API_HOST=127.0.0.1
API_PORT=3010
API_URL=https://exchange.arix.vu
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

BOT_TOKEN=
BOT_USERNAME=ExchangeCryptoTGBot
WEBAPP_URL=https://exchange.arix.vu
ADMIN_URL=https://exchange.arix.vu

ADMIN_EMAIL=admin@exchange.arix.vu
ADMIN_PASSWORD=ChangeMe123!
ADMIN_TELEGRAM_IDS=780404501,732092704

UPLOADS_DIR=/var/www/exchange.arix.vu/uploads

# Production: keep these false
ALLOW_DEPOSIT_SIMULATE=false
ALLOW_DEV_AUTH=false
ALLOW_MOCK_PAYOUTS=false
NODE_ENV=production

TON_HD_MNEMONIC=
TRON_HD_MNEMONIC=
