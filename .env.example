# Database
# Local SQLite:
# DATABASE_URL=file:C:/exdb/dev.db
# Production SQLite (VPS):
DATABASE_URL=file:/var/www/exchange.arix.vu/data/prod.db

# Optional Redis (API falls back to inline jobs if unavailable)
